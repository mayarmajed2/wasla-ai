# =============================================================================
# 1. APPLICATION & SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# =============================================================================
# 2. DATABASE & REDIS (MULTI-TENANT PERSISTENCE & BULLMQ QUEUES)
# =============================================================================
POSTGRES_USER=sofra_admin
POSTGRES_PASSWORD=sofra_local_dev_password
POSTGRES_DB=sofra_ai_prod
DATABASE_URL=postgresql://sofra_admin:sofra_local_dev_password@localhost:5432/sofra_ai_prod

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Debounce quiet window in milliseconds before merging burst customer messages
MESSAGE_DEBOUNCE_WINDOW_MS=3500

# =============================================================================
# 3. SECURITY, JWT & KMS ENVELOPE ENCRYPTION
# =============================================================================
JWT_ACCESS_SECRET=replace_with_64_byte_cryptographic_random_secret
JWT_REFRESH_SECRET=replace_with_64_byte_cryptographic_random_secret
# 32-byte hex key used for AES-256-GCM encryption of tenant Meta OAuth tokens
TENANT_SECRETS_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# =============================================================================
# 4. AI ORCHESTRATION & VOICE STT (PRIMARY + CIRCUIT-BREAKER FALLBACK)
# =============================================================================
OPENAI_API_KEY=sk-proj-replace_me
OPENAI_PRIMARY_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-large-v3-turbo

GEMINI_API_KEY=replace_me
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Timeout in ms before tripping circuit breaker to secondary LLM
LLM_TIMEOUT_MS=6000

# =============================================================================
# 5. META GRAPH API (WHATSAPP CLOUD API & INSTAGRAM MESSAGING API)
# =============================================================================
META_GRAPH_API_VERSION=v21.0
META_APP_ID=replace_with_meta_app_id
META_APP_SECRET=replace_with_meta_app_secret_for_hmac_sha256
META_WEBHOOK_VERIFY_TOKEN=replace_with_webhook_verify_token

# =============================================================================
# 6. RESTAURANT STAFF OPERATIONAL DISPATCH & SLA WATCHDOG
# =============================================================================
TELEGRAM_OPERATIONS_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=replace_with_telegram_webhook_secret
# SLA timers for unacknowledged orders
ORDER_ACK_REMINDER_SECONDS=120
ORDER_ACK_OWNER_ESCALATION_SECONDS=240
