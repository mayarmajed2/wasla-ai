{
  "name": "wasla-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Wasla AI (وصلة AI) - Multi-Tenant Conversational AI Sales, Ordering, Booking & Customer Automation Platform for WhatsApp & Instagram",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@wasla-ai/api",
    "dev:web": "npm run dev --workspace=@wasla-ai/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "psql $DATABASE_URL -f database/migrations/001_initial_multi_tenant_schema.sql"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
