{
  "name": "agent-company-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production Multi-Tenant AI Restaurant Ordering & Automation Platform (WhatsApp & Instagram DM)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@agent-company/api",
    "dev:web": "npm run dev --workspace=@agent-company/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "psql $DATABASE_URL -f database/migrations/001_initial_multi_tenant_schema.sql"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
